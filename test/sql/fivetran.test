# ------------------------------------------------------------------ syncs (sync history)

# The last 7 days of every connection; the 10-day-old sync is outside the API's window.
query TTTT
SELECT connection_id, id, status, reason FROM fivetran.main.syncs ORDER BY connection_id, id;
----
c_postgres	pg-s1	FAILURE	Replication slot is missing
c_postgres	pg-s2	CANCELED	Canceled by user
c_postgres	pg-s3	INCOMPLETE	Sync was interrupted
c_postgres	pg-s4	RESCHEDULED	Source rate limit
c_postgres	pg-s5	COMPLETED	NULL
c_salesforce	sf-s1	COMPLETED	NULL
c_salesforce	sf-s2	COMPLETED	NULL
c_salesforce	sf-s3	COMPLETED	NULL
c_salesforce	sf-s4	FAILURE	Salesforce API limit exceeded
c_sheets	gs-s1	INCOMPLETE	NULL
c_sheets	gs-s2	COMPLETED	NULL
c_stripe	st-s1	PAUSED	Connection paused

query TRRR
SELECT id, duration_seconds, extract_volume, load_volume FROM fivetran.main.syncs WHERE connection_id = 'c_salesforce' ORDER BY started_at DESC LIMIT 2;
----
sf-s1	480.0	1200.0	1180.0
sf-s2	600.0	900.0	900.0

query TT
SELECT id, ended_at IS NULL FROM fivetran.main.syncs WHERE connection_id = 'c_sheets' ORDER BY id;
----
gs-s1	true
gs-s2	false

# Without a started_at filter the request asks for (just under) the full 7 days.
query I
SELECT epoch_ms((query::JSON->>'end_time')::TIMESTAMPTZ) / 1000 - epoch_ms((query::JSON->>'start_time')::TIMESTAMPTZ) / 1000 <= 7 * 86400 FROM reqs('/v1/connections/c_sheets/sync-history') WHERE status = 200 ORDER BY seq DESC LIMIT 1;
----
true

# A started_at range becomes the start_time / end_time window. (Relative times use
# epoch_ms(...) / 1000: haybarn-unittest 2.0.1rc3 without ICU mis-binds epoch(now()) - n.)
query T
SELECT id FROM fivetran.main.syncs WHERE connection_id = 'c_postgres' AND started_at >= to_timestamp(epoch_ms(now()) / 1000 - 70 * 60) ORDER BY id;
----
pg-s1
pg-s2

query I
SELECT epoch_ms((query::JSON->>'start_time')::TIMESTAMPTZ) / 1000 BETWEEN epoch_ms(now()) / 1000 - 75 * 60 AND epoch_ms(now()) / 1000 - 65 * 60 FROM reqs('/v1/connections/c_postgres/sync-history') ORDER BY seq DESC LIMIT 1;
----
true

# A window entirely older than 7 days makes no sync-history request at all.
statement ok
CREATE TEMP TABLE sh_before AS SELECT count(*) AS n FROM reqs('/v1/connections/c_salesforce/sync-history');

query I
SELECT count(*) FROM fivetran.main.syncs WHERE connection_id = 'c_salesforce' AND started_at < TIMESTAMPTZ '2020-01-01 00:00:00+00';
----
0

query I
SELECT (SELECT count(*) FROM reqs('/v1/connections/c_salesforce/sync-history')) - n FROM sh_before;
----
0

