c_sheets	g_lake	google_sheets	finance_sheets	connected	syncing	on_schedule
c_stripe	g_warehouse	stripe	stripe	connected	paused	on_schedule

# Status details: tasks/warnings as LIST<STRUCT>, typed integers and timestamps.
query TTT
SELECT id, t.code, t.message FROM fivetran.main.connections, unnest(tasks) AS u(t) ORDER BY id;
----
c_hubspot	reconnect	Reauthorize HubSpot

query TT
SELECT id, w.code FROM fivetran.main.connections, unnest(warnings) AS u(w);
----
c_postgres	replication_slot_lag

query TIT
SELECT id, sync_frequency, failed_at FROM fivetran.main.connections WHERE failed_at > coalesce(succeeded_at, TIMESTAMPTZ '1970-01-01') ORDER BY id;
----
c_hubspot	60	2026-11-14 20:00:00+00
c_postgres	15	2026-11-14 23:10:00+00

query T
SELECT typeof(sync_frequency) || ',' || typeof(paused) || ',' || typeof(succeeded_at) || ',' || typeof(tasks) FROM fivetran.main.connections LIMIT 1;
----
INTEGER,BOOLEAN,TIMESTAMP WITH TIME ZONE,STRUCT(code VARCHAR, message VARCHAR, details VARCHAR)[]

