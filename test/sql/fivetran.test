fivetran	NULL	NULL	https://fivetran.com/dashboard/connections/c_stripe/status

# pipeline = pushes down as the connection listing's schema parameter.
query T
SELECT query::JSON->>'schema' FROM reqs('/v1/connections') ORDER BY seq DESC LIMIT 1;
----
stripe

# The exact shared column set and types, so it UNIONs with other orchestrators.
query TT
SELECT column_name, data_type FROM information_schema.columns WHERE table_catalog = 'fivetran' AND table_schema = 'unified' AND table_name = 'runs' ORDER BY ordinal_position;
----
orchestrator	VARCHAR
run_id	VARCHAR
pipeline	VARCHAR
status	VARCHAR
raw_status	VARCHAR
trigger	VARCHAR
queued_at	TIMESTAMP WITH TIME ZONE
started_at	TIMESTAMP WITH TIME ZONE
ended_at	TIMESTAMP WITH TIME ZONE
duration_seconds	DOUBLE
url	VARCHAR

query TTT
SELECT column_name, is_nullable, data_type FROM information_schema.columns WHERE table_catalog = 'fivetran' AND table_schema = 'unified' AND table_name = 'runs' AND column_name IN ('orchestrator', 'run_id', 'status', 'pipeline') ORDER BY column_name;
----
orchestrator	NO	VARCHAR
pipeline	YES	VARCHAR
run_id	NO	VARCHAR
status	NO	VARCHAR

