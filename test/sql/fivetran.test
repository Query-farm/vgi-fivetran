# ------------------------------------------------------------- constraints

# Attested keys reach DuckDB: ids are NOT NULL, per-connection tables reference connections.
query TT
SELECT column_name, is_nullable FROM information_schema.columns WHERE table_catalog = 'fivetran' AND table_name = 'syncs' AND column_name IN ('connection_id', 'id', 'status') ORDER BY column_name;
----
connection_id	NO
id	NO
status	YES

query T
SELECT constraint_type FROM duckdb_constraints() WHERE database_name = 'fivetran' AND table_name = 'syncs' AND constraint_type IN ('PRIMARY KEY', 'FOREIGN KEY') ORDER BY 1;
----
FOREIGN KEY
PRIMARY KEY

# --------------------------------------------------------------- read-only + hygiene

# Every request was a GET with valid Basic auth from the secret above, and every path
# was rate-limited exactly once (then retried successfully).
query I
SELECT count(*) FROM reqs('') WHERE status NOT IN (200, 401, 404, 429);
----
0

query I
SELECT count(*) FROM (SELECT path FROM reqs('') WHERE status = 429 GROUP BY path HAVING count(*) > 1);
----
0
