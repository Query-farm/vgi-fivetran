# connection_id pushdown: exactly the named connections' schemas are read, no listing.
statement ok
CREATE TEMP TABLE conn_before AS SELECT count(*) AS n FROM reqs('/v1/connections');

statement ok
CREATE TEMP TABLE pg_schema_before AS SELECT count(*) AS n FROM reqs('/v1/connections/c_postgres/schemas');

query II
SELECT count(*), count(*) FILTER (WHERE is_primary_key) FROM fivetran.main.connection_columns WHERE connection_id = 'c_postgres';
----
4	2

query II
SELECT (SELECT count(*) FROM reqs('/v1/connections')) - c.n, (SELECT count(*) FROM reqs('/v1/connections/c_postgres/schemas')) - p.n FROM conn_before c, pg_schema_before p;
----
0	1

