# name: test/sql/fivetran.test
# description: SQL tests for the fivetran worker against the offline Fivetran REST API replay server (test/mock_api/server.py)
# group: [fivetran]

require vgi

require-env FIVETRAN_WORKER

require-env FIVETRAN_FIXTURE_URL

# httpfs + json read the replay server's /__requests log to assert what was pushed down.
statement ok
LOAD httpfs;

statement ok
LOAD json;

statement ok
ATTACH 'fivetran' (TYPE vgi, LOCATION '{FIVETRAN_WORKER}');

# A request-log view: every request the worker sent, newest first by seq.
statement ok
CREATE MACRO reqs(p) AS TABLE SELECT * FROM read_json('{FIVETRAN_FIXTURE_URL}/__requests?path=' || p);

# ---------------------------------------------------------------- secret errors

statement error
SELECT count(*) FROM fivetran.main.accounts;
----
<REGEX>:.*no fivetran secret.*

statement ok
CREATE SECRET ft_bad (TYPE fivetran, API_KEY 'test-key', API_SECRET 'wrong', BASE_URL '{FIVETRAN_FIXTURE_URL}');

statement error
SELECT count(*) FROM fivetran.main.accounts;
----
<REGEX>:.*HTTP 401.*AuthFailed.*

statement ok
DROP SECRET ft_bad;

statement ok
CREATE SECRET ft_insecure (TYPE fivetran, API_KEY 'k', API_SECRET 's', BASE_URL 'http://api.fivetran.example');

statement error
SELECT count(*) FROM fivetran.main.accounts;
----
<REGEX>:.*https.*

statement ok
DROP SECRET ft_insecure;

statement ok
CREATE SECRET ft_nosecret (TYPE fivetran, API_KEY 'k', BASE_URL '{FIVETRAN_FIXTURE_URL}');

statement error
SELECT count(*) FROM fivetran.main.accounts;
----
<REGEX>:.*API_SECRET.*

statement ok
DROP SECRET ft_nosecret;

# Small pages so every listing exercises the externalized cursor.
statement ok
CREATE SECRET ft (TYPE fivetran, API_KEY 'test-key', API_SECRET 'test-secret', BASE_URL '{FIVETRAN_FIXTURE_URL}/v1', PAGE_SIZE 2);

# ---------------------------------------------------------------------- account

query TTTT
SELECT id, account_name, user_id, system_key_id FROM fivetran.main.accounts;
----
acc_acme	Acme Analytics	u_ada	NULL

# Rate limit: the first request to each path is a 429 with Retry-After; the worker
# waited and retried. A single object is not paged (no limit/cursor sent).
query TT
SELECT status, query FROM reqs('/v1/account/info') WHERE status <> 401 ORDER BY seq;
----
429	{}
200	{}

# Every request carried the versioned JSON Accept header.
query I
SELECT count(*) FROM reqs('/v1/account/info') WHERE accept <> 'application/json;version=2';
----
0

# ------------------------------------------------------------------------ users

query TTTT
SELECT id, email, active, user_type FROM fivetran.main.users ORDER BY id;
----
u_ada	ada@acme.example	true	REGULAR_USER
u_alan	alan@acme.example	false	REGULAR_USER
u_grace	grace@acme.example	true	REGULAR_USER
u_kat	kat@acme.example	true	REGULAR_USER
u_svc_ci	svc-ci@acme.example	true	SERVICE_ACCOUNT

# 5 users at 2 per page: 3 successful pages, the later ones carrying the cursor.
query II
SELECT count(*), count(*) FILTER (WHERE query::JSON->>'cursor' IS NOT NULL) FROM reqs('/v1/users') WHERE status = 200;
----
3	2

query I
SELECT DISTINCT query::JSON->>'limit' FROM reqs('/v1/users') WHERE status = 200;
----
2

# Pushdown: active = true, user_type and has_api_key become query parameters.
query T
SELECT email FROM fivetran.main.users WHERE active AND user_type = 'REGULAR_USER' AND has_api_key = false ORDER BY email;
----
grace@acme.example
kat@acme.example

query TTT
SELECT query::JSON->>'active', query::JSON->>'user_type', query::JSON->>'has_api_key' FROM reqs('/v1/users') ORDER BY seq DESC LIMIT 1;
----
true	REGULAR_USER	false

# active = false is not pushed (Fivetran's active=false is not "only suspended"); the SDK filters.
query T
SELECT email FROM fivetran.main.users WHERE NOT active;
----
alan@acme.example

query T
SELECT query::JSON->>'active' FROM reqs('/v1/users') ORDER BY seq DESC LIMIT 1;
----
NULL

# Typed timestamps with microsecond precision.
query T
SELECT logged_in_at FROM fivetran.main.users WHERE id = 'u_ada';
----
2026-11-14 08:15:00+00

